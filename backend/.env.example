# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CELLSPARK_LLM=gemini

# MySQL / MariaDB (XAMPP). Use the application user, which has row access
# only (SELECT/INSERT/UPDATE/DELETE on cellspark.*), never root.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=
