# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CELLSPARK_LLM=gemini

# MySQL / MariaDB (XAMPP). Use the application user, which has row access
# only (SELECT/INSERT/UPDATE/DELETE on cellspark.*), never root.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# --- AWS (optional; leave empty to run entirely locally) -------------------
# STORAGE: local (default) or s3. Reads follow each stored locator, so rows
# saved before switching still open.
STORAGE=
# Learner Lab credentials are temporary; AWS_SESSION_TOKEN is required and all
# three change each session.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
S3_BUCKET=
# 1 = FastAPI also serves frontend/dist (EC2: one port, same origin)
SERVE_FRONTEND=
APP_PORT=
# ec2 on the EC2 instance; shown by /api/health/storage
INSTANCE_LABEL=
